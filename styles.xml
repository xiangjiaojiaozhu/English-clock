<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#246BCE</item>
        <item name="android:colorPrimary">#246BCE</item>
        <item name="android:statusBarColor">#F7F9FC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowBackground">@color/page_bg</item>
    </style>
    <style name="LockTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/lock_bg</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
